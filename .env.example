# Email address and SMTP app password used to send verification codes.
EMAIL=example@email.com
APP_PASSWORD=your_gmail_app_password

# Google AI Studio / Gemini API key for note content, metadata, flashcards, and quizzes.
GEMINI_API_KEY=your_gemini_api_key

# Cloudflare Workers AI credentials for the AI intent router.
# Create a scoped API token with Workers AI - Read and Workers AI - Edit permissions.
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
